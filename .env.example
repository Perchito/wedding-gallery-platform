# Copy to .env.local and fill in once you have a Supabase project
# (https://supabase.com/dashboard -> New Project -> Project Settings -> API).
# Until these are set, the app runs entirely on mock data (lib/mock-data.ts)
# and lib/supabase/env.ts#isSupabaseConfigured() returns false.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Never expose to the browser or
# commit a real value. Only needed for admin/background-job code
# (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
